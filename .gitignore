# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (match at any depth — `/node_modules` only matched the repo
# root and let nested trees like `Claude Docs/deck/node_modules/**` leak in).
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Office lock files
~$*

# Generated docs workflow diagrams (whole tree — rendered output, not source)
/Claude Docs/workflow-diagrams/

# Logo-rebrand scratch: asset-gen scripts, build/server logs (contain local
# Supabase keys), and old-logo backups. Outputs already live in /public + the
# committed README; the scratch itself never belongs in the repo.
/Claude Docs/logo-rebrand/work/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase
supabase/.temp
supabase/.branches
backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code session state (worktrees, plans, memory, settings). Personal
# per-machine; never belongs in the repo.
.claude/

# Agent skill installs (personal, per-machine). Managed via `npx skills`.
.agents/
.augment/
.trae/
.windsurf/
skills-lock.json

# Scratch / throwaway files
.tmp/
.tmp-*

# Local performance-audit reports from open-review agents (Kimi/DeepSeek/GPT etc).
# Personal/per-machine analysis output; never belongs in the repo.
agent-reviews/
Agents/

# Local admin/dev one-off scripts (not part of the app build)
/approve.ts
/set-supplier-state.ts
/update-supplier.ts
# Resets passwords for local test accounts; contains hardcoded dev creds.
/scripts/reset-test-passwords.ts

# Sensitive / PII docs that must never reach GitHub:
# - exported send logs contain real recipient email addresses
# - legal/payments packages are pre-legal-signoff drafts
/Claude Docs/emails-sent-*.csv
/Claude Docs/deliverables/legal-payments-package-*/

# Claude Docs scratch / generated / personal (working artifacts, not deliverables)
/Claude Docs/My-Professional-Role-Summary.docx
/Claude Docs/context-ingest-2026-06-04/
/Claude Docs/audit-2026-05-31/
/Claude Docs/audit-routes-2026-06-01/
/Claude Docs/core-workflows-and-data-flows.md
/Claude Docs/organizer-onboarding-revamp.md
/Claude Docs/deploy/dns-dmarc-and-apex-routing.md
/Claude Docs/scripts/legal-docx/
# One-off Arabic doc/report generators dropped in root scripts/. The maintained
# generators live under "Claude Docs/scripts/" and stay committed.
/scripts/build_*_ar*.js
